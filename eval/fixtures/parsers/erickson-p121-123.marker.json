          "images": {}
        },
        {
          "id": "/page/2/Text/10",
          "block_type": "Text",
          "html": "<p block-type=\"Text\">In a nutshell, dynamic programming is <i>recursion without repetition</i>. Dynamic programming algorithms store the solutions of intermediate subproblems, often <i>but not always</i> in some kind of array or table. Many algorithms students</p>",
          "polygon": [
            [
              69.40072748115978,
              599.0481377598524
            ],
            [
              430.3973398164123,
              599.0481377598524
            ],
            [
              430.3973398164123,
              640.8285980224609
            ],
            [
              69.40072748115978,
              640.8285980224609
