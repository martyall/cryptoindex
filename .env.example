# Local development only. Change for anything beyond that.
# Copied to .env by `make .env`. The Makefile passes .env to `uv run` for
# migrate, test and run; docker compose reads it for the database container.
# Quote any value containing spaces: at the first unquoted one, uv drops that
# line and every line after it, with only a warning.

# Postgres superuser, used by the container, migrations, and test setup.
CI_PG_ADMIN_PASSWORD=postgres
CI_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/cryptoindex
# Role passwords are taken from these DSNs and applied by `make migrate`.
CI_INGEST_DSN=postgresql://ci_ingest:ingest@localhost:5432/cryptoindex
CI_QUERY_DSN=postgresql://ci_query:query@localhost:5432/cryptoindex

CI_DATA_DIR=./data
CI_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
CI_EMBED_DIMS=1024
CI_EMBED_DEVICE=mps
CI_LLM_BACKEND=anthropic        # anthropic | openai_format | fake
ANTHROPIC_API_KEY=
CI_LLM_BASE_URL=http://localhost:8080/v1   # local server when openai_format
CI_LLM_MODEL=
CI_PARSER=paddle                 # paddle (D21) | marker; paddle needs `make paddle-server`
CI_PADDLE_VLM_URL=http://localhost:8111/
CI_EPRINT_BASE=https://eprint.iacr.org
CI_FETCH_DELAY_S=2.0
CI_USER_AGENT="cryptoindex/0.1 (personal research index)"

# Pipeline runner
CI_QUEUE_CAPACITY=64
CI_CONCURRENCY_PARSE=1
CI_CONCURRENCY_SEGMENT=4
CI_CONCURRENCY_EMBED=1
CI_MAX_ATTEMPTS=3
CI_STALE_LOCK_S=600

# HTTP API
CI_MAX_UPLOAD_MB=100
CI_API_HOST=127.0.0.1
CI_API_PORT=8000
CI_LOG_LEVEL=INFO
